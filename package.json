{
  "name": "openclaw-kagi",
  "version": "1.1.0",
  "description": "Privacy-first web search powered by Kagi",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "kagi",
    "web-search",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/FieldFortress-JH/openclaw-kagi"
  },
  "author": "Clawdia <clawdia@mailbox.org>",
  "license": "MIT",
  "peerDependencies": {
    "openclaw": ">=2026.11.2"
  },
  "dependencies": {
    "linkedom": "^0.18.15"
  },
  "devDependencies": {
    "openclaw": "2026.11.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.11.2"
    },
    "build": {
      "openclawVersion": "2026.11.2"
    }
  },
  "bugs": {
    "url": "https://github.com/FieldFortress-JH/openclaw-kagi/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
